      "281d3355-c6a2-47e5-b8a9-c468f26c9281": {
        "id": "281d3355-c6a2-47e5-b8a9-c468f26c9281",
        "name": "",
        "type": "ClassOCLConstraint",
        "owner": null,
        "bounds": {
          "x": -830,
          "y": -230,
          "width": 160,
          "height": 100
        },
        "description": "",
        "constraint": "context Clause\ninv UniqueLiteral:\n  self.literal->forAll(l1, l2 | \n    l1 <> l2 implies (l1.variable <> l2.variable or l1.isNegated <> l2.isNegated)\n  )"
      },
      "034c920d-be8d-4574-86ee-bb75e3ae8eda": {
