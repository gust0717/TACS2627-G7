        "type": "ClassOCLConstraint",
        "owner": null,
        "bounds": {
          "x": -830,
          "y": -100,
          "width": 160,
          "height": 100
        },
        "description": "",
        "constraint": "context Clause\ninv NoTautology: \n  self.literal->forAll(l1, l2 | \n    (l1 <> l2 and l1.variable = l2.variable) \n    implies l1.isNegated = l2.isNegated\n  )"
      }
